# Copy to .env and fill in.

# KIS Developers (Korea Investment & Securities)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=        # 8-digit front + 2-digit product code
KIS_ACCOUNT_PROD=01 # 01 for cash account
KIS_ENV=vts         # vts = 모의투자, prod = 실계좌
KIS_DRY_RUN=true    # hard guard; runner refuses live order unless false

# Claude API (for News/LLM classification, Layer B3)
ANTHROPIC_API_KEY=

# HuggingFace cache (optional)
HF_HOME=
