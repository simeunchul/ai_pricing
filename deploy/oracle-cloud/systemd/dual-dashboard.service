[Unit]
Description=KIS Dual Trading Dashboard (Streamlit)
Documentation=https://github.com/simeunchul/ai_pricing
After=network-online.target dual-bot.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ai_pricing
Environment="PATH=/home/ubuntu/ai_pricing/venv/bin:/usr/bin:/bin"

ExecStart=/home/ubuntu/ai_pricing/venv/bin/streamlit run scripts/dual_dashboard.py \
    --server.headless=true \
    --server.port=8501 \
    --server.address=0.0.0.0 \
    --server.runOnSave=true \
    --browser.gatherUsageStats=false

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dual-dashboard

MemoryHigh=256M
MemoryMax=512M

[Install]
WantedBy=multi-user.target
