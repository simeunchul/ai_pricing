# 자동매매 시스템 환경변수 — 이 파일을 .env 로 복사 후 편집
# .env 는 git ignored (절대 commit 하지 말 것)

# ════════════════════════════════════════════════════════════
# KIS Developers API (한국투자증권)
# ════════════════════════════════════════════════════════════
KIS_APP_KEY=PASTE_YOUR_APP_KEY_HERE
KIS_APP_SECRET=PASTE_YOUR_APP_SECRET_HERE
KIS_ACCOUNT=PASTE_YOUR_8DIGIT_ACCOUNT_HERE
KIS_ACCOUNT_PROD=01

# 모드 선택:
#   vts  = 모의투자 (가짜 자금) — 권장 시작점
#   prod = 실거래 (진짜 돈, 매우 주의!)
KIS_ENV=vts

# DRY_RUN: true 면 실제 주문 안 함 (시그널 로깅만)
#   prod 환경에서도 처음엔 dry_run=true 로 시작 권장 (시그널 검증)
KIS_DRY_RUN=false

# ════════════════════════════════════════════════════════════
# Binance Futures (USDT-M Perpetual)
# ════════════════════════════════════════════════════════════
# 모드 선택:
#   testnet = 모의투자 (가짜 USDT) — 권장 시작점
#   mainnet = 실거래 (진짜 돈, 매우 주의!)
BINANCE_ENV=testnet

# Testnet 키 (BINANCE_ENV=testnet 일 때 사용)
# 발급: https://testnet.binancefuture.com → 이메일 가입 → API Management
BINANCE_TESTNET_API_KEY=PASTE_YOUR_TESTNET_KEY_HERE
BINANCE_TESTNET_API_SECRET=PASTE_YOUR_TESTNET_SECRET_HERE

# Mainnet 키 (BINANCE_ENV=mainnet 일 때 사용 — 실거래!)
# 발급: https://www.binance.com → API Management
# ⚠ 실거래 키 — 절대 노출 금지. 출금 권한 OFF 권장.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# DRY_RUN: true 면 실제 주문 안 함
BINANCE_DRY_RUN=false

# ════════════════════════════════════════════════════════════
# Selective: Naver Search API (뉴스 분류용)
# ════════════════════════════════════════════════════════════
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ════════════════════════════════════════════════════════════
# Selective: DART Open API (전자공시)
# ════════════════════════════════════════════════════════════
DART_API_KEY=

# ════════════════════════════════════════════════════════════
# Selective: Claude API (B3 high-accuracy 뉴스 분류)
# ════════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=
